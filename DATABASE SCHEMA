-- ============================================
-- USERS (base table for all roles)
-- ============================================
CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR(255) UNIQUE,
    mobile VARCHAR(15) UNIQUE,
    enrollment_number VARCHAR(50) UNIQUE,
    password_hash VARCHAR(255) NOT NULL,
    role VARCHAR(50) NOT NULL CHECK (role IN (
        'student','parent','faculty','mentor',
        'warden','admin','super_admin','accountant','event_coordinator'
    )),
    is_active BOOLEAN DEFAULT TRUE,
    is_verified BOOLEAN DEFAULT FALSE,
    otp_code VARCHAR(10),
    otp_expires_at TIMESTAMP,
    last_login TIMESTAMP,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- STUDENTS
-- ============================================
CREATE TABLE students (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    full_name VARCHAR(255) NOT NULL,
    enrollment_number VARCHAR(50) UNIQUE NOT NULL,
    roll_number VARCHAR(50),
    college_name VARCHAR(255),
    department VARCHAR(100),
    branch VARCHAR(100),
    course VARCHAR(100),
    semester INTEGER,
    year INTEGER,
    date_of_birth DATE,
    gender VARCHAR(20),
    blood_group VARCHAR(10),
    aadhaar_number VARCHAR(20),
    address TEXT,
    student_contact VARCHAR(15),
    emergency_contact VARCHAR(15),
    mother_name VARCHAR(255),
    father_name VARCHAR(255),
    parent_contact VARCHAR(15),
    guardian_name VARCHAR(255),
    guardian_contact VARCHAR(15),
    medical_details TEXT,
    profile_photo_url VARCHAR(500),
    qr_code_url VARCHAR(500),
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- FACULTY
-- ============================================
CREATE TABLE faculty (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    user_id UUID REFERENCES users(id) ON DELETE CASCADE,
    full_name VARCHAR(255) NOT NULL,
    employee_id VARCHAR(50) UNIQUE NOT NULL,
    department VARCHAR(100),
    designation VARCHAR(100),
    subject_specialization VARCHAR(255),
    contact VARCHAR(15),
    profile_photo_url VARCHAR(500),
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- ATTENDANCE
-- ============================================
CREATE TABLE attendance (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    student_id UUID REFERENCES students(id) ON DELETE CASCADE,
    faculty_id UUID REFERENCES faculty(id),
    subject VARCHAR(100),
    date DATE NOT NULL,
    status VARCHAR(20) CHECK (status IN ('present','absent','late','excused')),
    attendance_type VARCHAR(30) CHECK (attendance_type IN ('classroom','hostel_night','lab')),
    remarks TEXT,
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- FEES
-- ============================================
CREATE TABLE fees (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    student_id UUID REFERENCES students(id) ON DELETE CASCADE,
    fee_type VARCHAR(50) CHECK (fee_type IN ('tuition','hostel','transport','exam','other')),
    amount DECIMAL(10,2) NOT NULL,
    due_date DATE,
    paid_date DATE,
    status VARCHAR(20) CHECK (status IN ('pending','paid','overdue','partial')),
    transaction_id VARCHAR(255),
    receipt_url VARCHAR(500),
    remarks TEXT,
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- HOSTEL
-- ============================================
CREATE TABLE hostels (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255) NOT NULL,
    type VARCHAR(20) CHECK (type IN ('boys','girls')),
    total_rooms INTEGER,
    warden_id UUID REFERENCES users(id)
);

CREATE TABLE hostel_rooms (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    hostel_id UUID REFERENCES hostels(id),
    room_number VARCHAR(20) NOT NULL,
    capacity INTEGER DEFAULT 4,
    current_occupancy INTEGER DEFAULT 0,
    floor INTEGER
);

CREATE TABLE hostel_allocations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    student_id UUID REFERENCES students(id),
    room_id UUID REFERENCES hostel_rooms(id),
    check_in_date DATE,
    check_out_date DATE,
    is_active BOOLEAN DEFAULT TRUE
);

-- ============================================
-- GATE PASS
-- ============================================
CREATE TABLE gate_passes (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    student_id UUID REFERENCES students(id),
    reason TEXT,
    out_date TIMESTAMP,
    expected_return TIMESTAMP,
    actual_return TIMESTAMP,
    status VARCHAR(20) CHECK (status IN ('pending','approved','rejected','returned')),
    approved_by UUID REFERENCES users(id),
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- TIMETABLE
-- ============================================
CREATE TABLE timetable (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    department VARCHAR(100),
    semester INTEGER,
    day_of_week VARCHAR(15),
    start_time TIME,
    end_time TIME,
    subject VARCHAR(100),
    faculty_id UUID REFERENCES faculty(id),
    room VARCHAR(50),
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- EXAMS & RESULTS
-- ============================================
CREATE TABLE exams (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR(255),
    exam_type VARCHAR(50) CHECK (exam_type IN ('internal','external','practical','viva')),
    department VARCHAR(100),
    semester INTEGER,
    date DATE,
    start_time TIME,
    end_time TIME,
    room VARCHAR(50),
    max_marks INTEGER
);

CREATE TABLE results (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    student_id UUID REFERENCES students(id),
    exam_id UUID REFERENCES exams(id),
    subject VARCHAR(100),
    marks_obtained DECIMAL(5,2),
    max_marks INTEGER,
    grade VARCHAR(5),
    status VARCHAR(20) CHECK (status IN ('pass','fail','absent','withheld')),
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- EVENTS
-- ============================================
CREATE TABLE events (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    title VARCHAR(255) NOT NULL,
    description TEXT,
    event_date TIMESTAMP,
    venue VARCHAR(255),
    organizer_id UUID REFERENCES users(id),
    max_participants INTEGER,
    registration_deadline TIMESTAMP,
    is_active BOOLEAN DEFAULT TRUE,
    created_at TIMESTAMP DEFAULT NOW()
);

CREATE TABLE event_registrations (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    event_id UUID REFERENCES events(id),
    student_id UUID REFERENCES students(id),
    registration_date TIMESTAMP DEFAULT NOW(),
    qr_code VARCHAR(500),
    entry_status VARCHAR(20) DEFAULT 'registered'
);

-- ============================================
-- NOTIFICATIONS
-- ============================================
CREATE TABLE notifications (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    title VARCHAR(255),
    message TEXT,
    target_role VARCHAR(50),
    target_user_id UUID REFERENCES users(id),
    is_read BOOLEAN DEFAULT FALSE,
    notification_type VARCHAR(50),
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- FEEDBACK
-- ============================================
CREATE TABLE feedback (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    submitted_by UUID REFERENCES users(id),
    target_type VARCHAR(50) CHECK (target_type IN ('faculty','hostel','general','event')),
    target_id UUID,
    rating INTEGER CHECK (rating BETWEEN 1 AND 5),
    comment TEXT,
    is_anonymous BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- FOOD MENU
-- ============================================
CREATE TABLE food_menu (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    hostel_id UUID REFERENCES hostels(id),
    day_of_week VARCHAR(15),
    meal_type VARCHAR(20) CHECK (meal_type IN ('breakfast','lunch','dinner','snack')),
    items TEXT,
    nutrition_info TEXT
);

-- ============================================
-- DOCUMENTS
-- ============================================
CREATE TABLE documents (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    title VARCHAR(255),
    file_url VARCHAR(500),
    uploaded_by UUID REFERENCES users(id),
    target_role VARCHAR(50),
    document_type VARCHAR(50),
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- MENTORING
-- ============================================
CREATE TABLE mentoring_sessions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    mentor_id UUID REFERENCES faculty(id),
    student_id UUID REFERENCES students(id),
    session_date DATE,
    notes TEXT,
    next_meeting DATE,
    created_at TIMESTAMP DEFAULT NOW()
);

-- ============================================
-- DISCIPLINE
-- ============================================
CREATE TABLE discipline_records (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    student_id UUID REFERENCES students(id),
    incident_date DATE,
    description TEXT,
    action_taken TEXT,
    fine_amount DECIMAL(8,2) DEFAULT 0,
    recorded_by UUID REFERENCES users(id),
    parent_notified BOOLEAN DEFAULT FALSE,
    created_at TIMESTAMP DEFAULT NOW()
);

-- Indexes for performance
CREATE INDEX idx_attendance_student ON attendance(student_id);
CREATE INDEX idx_attendance_date ON attendance(date);
CREATE INDEX idx_fees_student ON fees(student_id);
CREATE INDEX idx_results_student ON results(student_id);
CREATE INDEX idx_notifications_user ON notifications(target_user_id);
